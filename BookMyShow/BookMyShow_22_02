class BookingService {

    PaymentService paymentService;

    public String book(Long showId, List<Seat> seats) {
        double amt;
        for(Seat s : seats){
            if(s.isBooked())
                return "Invalid Seat Selection";
            amt += s.getPrice();
            s.setIsBooked(true);
        }

        PaymentType paymentType = Payment.CARD;
        paymentService = PaymentFactory.getPaymentService(paymentType);
        paymentService.pay(amt);
    }
}

